GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# gemini | groq | anthropic | mock
CARE_LLM_PROVIDER=gemini

# memory | neo4j
CARE_GRAPH_BACKEND=memory

CARE_NEO4J_URI=bolt://127.0.0.1:7687
CARE_NEO4J_USER=neo4j
CARE_NEO4J_PASSWORD=password

# simple | transformers
CARE_MODEL_BACKEND=simple

# Set to true to inject confident mistakes for demo purposes
CARE_FAULT_INJECT=false

# Optional path to a fitted isotonic calibrator JSON
CARE_CONFIDENCE_CALIBRATOR_PATH=
